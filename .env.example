# Local fixture mode (no database)
TV2_REPOSITORY=fixture

# Supabase mode (recommended for TV2 hosted development).
# TV2_REPOSITORY=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Direct PostgreSQL mode retained for portability/local development.
# TV2_REPOSITORY=postgres
# DATABASE_URL=postgresql://tv2:CHANGE_ME@localhost:5432/tv2

# IMPORTANT: there is intentionally no DEFAULT_COUNTRY_CODE.
# A non-global List Number must receive country context from the client/user setting.
